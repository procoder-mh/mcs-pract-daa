Q1) Graph Coloring
#include<stdio.h>

int m,x[10];

void nextvalue(int k,int n,int graph[10][10])
{
    int j;

    while(1)
    {
        x[k]=(x[k]+1)%(m+1);

        if(x[k]==0)
            return;

        for(j=1;j<=n;j++)
        {
            if(graph[k][j]!=0 && x[k]==x[j])
                break;
        }

        if(j==n+1)
            return;
    }
}

void mcoloring(int k,int n,int graph[10][10])
{
    int i;

    while(1)
    {
        nextvalue(k,n,graph);

        if(x[k]==0)
            return;

        if(k==n)
        {
            for(i=1;i<=n;i++)
                printf("%d ",x[i]);

            printf("\n");
        }
        else
            mcoloring(k+1,n,graph);
    }
}

int main()
{
    int graph[10][10],i,j,n;

    printf("Enter vertices:");
    scanf("%d",&n);

    printf("Enter adjacency matrix:\n");

    for(i=1;i<=n;i++)
    {
        for(j=1;j<=n;j++)
            scanf("%d",&graph[i][j]);
    }

    printf("Enter number of colors:");
    scanf("%d",&m);

    mcoloring(1,n,graph);

    return 0;
}
