Q1) Matrix Chain Multiplication
#include<stdio.h>

int main()
{
    int p[10],m[10][10];
    int i,j,k,n,L,q;

    printf("Enter number of matrices:");
    scanf("%d",&n);

    printf("Enter dimensions:\n");

    for(i=0;i<=n;i++)
        scanf("%d",&p[i]);

    for(i=1;i<=n;i++)
        m[i][i]=0;

    for(L=2;L<=n;L++)
    {
        for(i=1;i<=n-L+1;i++)
        {
            j=i+L-1;
            m[i][j]=9999;

            for(k=i;k<=j-1;k++)
            {
                q=m[i][k]+m[k+1][j]+p[i-1]*p[k]*p[j];

                if(q<m[i][j])
                    m[i][j]=q;
            }
        }
    }

    printf("Minimum multiplications=%d",m[1][n]);

    return 0;
}
